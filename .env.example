# Postgres connection string for the PropertyOps Neon database.
# Fully separate from AssetOps — its own instance, its own credentials.
DATABASE_URL=

# Credentials for the initial administrator user created by `npm run db:seed`.
# Only used by that script; not read by the application at runtime.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Resend API key for the PropertyOps transactional email foundation.
# Fully separate from AssetOps — its own account, its own key.
RESEND_API_KEY=

# "From" address used for outbound transactional email.
EMAIL_FROM_ADDRESS=

# Kill switch for outbound email. Defaults to disabled unless this is exactly "true".
EMAIL_ENABLED=false

# Read/write token for the PropertyOps Vercel Blob store (private file storage).
# Fully separate from AssetOps — its own store, its own token.
BLOB_READ_WRITE_TOKEN=

# Shared secret used by the timing-safe cron-auth helper to authenticate
# scheduled/background job requests. PropertyOps-specific; never shared with AssetOps.
PROPERTYOPS_CRON_SECRET=
